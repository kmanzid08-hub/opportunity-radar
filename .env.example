# Local development defaults to SQLite when DATABASE_URL is omitted.
DATABASE_URL=sqlite:///./opportunities.db
BRAVE_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
COMPANY_MATCH_MINIMUM_SCORE=70
ENABLE_INTERNAL_SCHEDULER=false
INBOX_NO_DEADLINE_MAX_AGE_DAYS=45

# Invite-only access is always enforced; there is no environment auth bypass.
APP_ENV=development
# Required in production, for example https://your-private-beta-host (no trailing slash).
PUBLIC_ORIGIN=
# Neon example (use your own secret, never commit it):
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DATABASE?sslmode=require
